<Window x:Class="CofCFishingBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash of Critters Fishing Bot"
        Width="500"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1c1c1c">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#292929"/>
            <Setter Property="Foreground" Value="#e1ffff"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                    Property="Background"
                                    Value="#303030"/>
                            </Trigger>

                            <!-- Gedrückt -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                    Property="Background"
                                    Value="#262626"/>
                            </Trigger>

                            <!-- Deaktiviert -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border"
                                    Property="Opacity"
                                    Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">

        <Border Background="#292929"
                CornerRadius="10"
                Padding="20"
                BorderBrush="#272727"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Überschrift -->
                <TextBlock Text="Clash of Critters Fishing Bot"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#e1ffff"
                           FontFamily="Arial"
                           Margin="0,0,0,15"/>

                <!-- Anleitung -->
                <TextBlock Grid.Row="1"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="#e1ffff"
                           FontFamily="Arial"><Run Text="1. BlueStacks Settings (recommended) "/><LineBreak/><Run/><LineBreak/><Run Text="• 240 DPI "/><Run Text="&#x9;"/><Run Language="de-de" Text="&#x9;"/><Run Text="• Samsung Galaxy S20 Ultra"/><LineBreak/><Run Text="• Window Mode "/><Run Text="&#x9;"/><Run Language="de-de" Text="&#x9;"/><Run Text="• Portrait "/><LineBreak/><Run/><LineBreak/><Run Text="2. Open the Fishing Contest screen."/><LineBreak/><Run/><LineBreak/><Run Text="3. Press Start or F6."/></TextBlock>

                <!-- Buttons -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StartButton"
                            Grid.Column="0"
                            Content="▶ Start (F6)"
                            Height="40"
                            Click="Start_Button_Click"/>

                    <Button x:Name="StopButton"
                            Grid.Column="2"
                            Content="■ Stop (F6)"
                            Height="40"
                            Click="Stop_Button_Click"
                            IsEnabled="False"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
